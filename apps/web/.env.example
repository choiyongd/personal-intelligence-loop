# Copy to .env.local. Obtain local values from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_anon_or_publishable_key
APP_ORIGIN=http://127.0.0.1:3100
# 브라우저에서 여는 주소와 같아야 합니다(localhost와 127.0.0.1은 서로 다른 쿠키 영역). dev(3000)로 실행할 때는 http://127.0.0.1:3000
# Public, read-only synthetic preview at /demo. Never bypasses private routes.
ENABLE_DEMO=true

# 메일 발송과 보관함 (서버 전용, 브라우저에 노출되지 않음)
# Supabase 서버 키: 대시보드 Project Settings > API Keys의 secret 키(또는 service_role 키). Vercel의 Supabase 연동은 SUPABASE_SERVICE_ROLE_KEY로 넣어 줍니다.
SUPABASE_SECRET_KEY=
# 실제 메일: Resend API 키와 인증된 보내는 주소. 로컬에서는 대신 MAILPIT_URL(npx supabase status의 Mailpit 주소)을 쓰면 메일이 로컬 받은편지함에 쌓입니다.
RESEND_API_KEY=
MAIL_FROM="loop. <newsletter@your-domain.example>"
# MAILPIT_URL=http://127.0.0.1:54324
# 정기 발송 호출용 비밀값(16자 이상). GitHub Actions 저장소 비밀값 CRON_SECRET과 같은 값이어야 합니다.
CRON_SECRET=

# 운영자 정보: 개인정보 처리방침(/privacy)과 모든 메일 아래에 표시됩니다. 실제 독자를 받기 전에 채워 주세요.
OPERATOR_NAME=
OPERATOR_CONTACT=
# 사업자 등록 후
# OPERATOR_BIZ_NO=
# OPERATOR_ADDRESS=
# PRIVACY_OFFICER=
# PRIVACY_EFFECTIVE_DATE=2026-11-01
# OPERATOR_REP=          # 대표자 (유료 판매 시 필수)
# OPERATOR_PHONE=        # 전화번호 (유료 판매 시 필수)
# OPERATOR_MAIL_ORDER_NO= # 통신판매업 신고번호 (유료 판매 시 필수)
# 영어판(미국 독자)용. 미국 메일법(CAN-SPAM)은 모든 메일 아래에 실제 우편 주소를 요구합니다. 비우면 위 한국어 값을 씁니다.
# OPERATOR_NAME_EN=        # 예: loop. (Your Company Co., Ltd.)
# OPERATOR_ADDRESS_EN=     # 예: 123 Teheran-ro, Gangnam-gu, Seoul 06234, Republic of Korea

# 유료 구독(토스페이먼츠 카드 자동결제). BILLING_ENABLED=true일 때만 켜집니다. 켜지면 플랜은 쿠키가 아니라 실제 결제로만 정해집니다.
# BILLING_ENABLED=true
# TOSS_CLIENT_KEY=test_ck_...   # 토스페이먼츠 개발자센터 > API 키 (클라이언트 키)
# TOSS_SECRET_KEY=test_sk_...   # 시크릿 키. 절대 공개하지 마세요.
# BILLING_ENCRYPTION_KEY=       # 빌링키 암호화용 32바이트 base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 로컬 시험: node scripts/fake-toss.mjs 실행 후 TOSS_API_BASE=http://127.0.0.1:4999 TOSS_SECRET_KEY=test_sk_fake
